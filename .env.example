# ==============================================================================
# CertProof Root Environment Configuration Reference
# ==============================================================================
# See frontend/.env.local.example for local Anvil setup (APP_ENV=local).
# See frontend/.env.sepolia.example for Sepolia testnet staging setup (APP_ENV=staging).
# ==============================================================================

# Explicit Deployment Mode:
# - 'local', 'development', or 'test': Permits convenience development defaults on loopback.
# - 'staging' or 'production': STRICTLY rejects default, placeholder, or missing credentials.
APP_ENV=local

# Docker Compose Service Ports (Loopback bound)
APP_PORT=3010
MONGO_PORT=27017
ANVIL_PORT=8545

# Database Credentials (Local development convenience defaults)
MONGO_ROOT_USER=certproof_admin
MONGO_ROOT_PASSWORD=certproof_local_pass
MONGO_DATABASE=certproof

# Cryptographic Session Encryption Secret
SESSION_SECRET=certproof_local_production_session_secret_32bytes_long

# Public Client Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3010
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_REGISTRY_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org
