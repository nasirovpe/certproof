# ==============================================================================
# CertProof — Sepolia Staging Deployment Environment Example
# ==============================================================================
# All credentials below are sanitized placeholders.
# Generate strong, random secrets in your deployment secrets manager before launching.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Side Configuration (Read strictly at server runtime; never sent to browser)
# ------------------------------------------------------------------------------
# Non-Local Deployment Environment: Strict rejection of development/placeholder credentials
APP_ENV=staging

# Production Authenticated MongoDB Connection URI
MONGODB_URI=mongodb://certproof_user:REPLACE_WITH_STRONG_GENERATED_PASSWORD@mongodb.internal:27017/certproof_sepolia?authSource=admin&replicaSet=rs0&tls=true

# Cryptographic Session Encryption Secret (Minimum 32 cryptographically secure random bytes)
# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_MIN_32_BYTES

# Node Execution Environment
NODE_ENV=production

# Reverse Proxy Trust (Set to 'true' when behind Nginx, Cloudflare, or AWS ALB)
TRUST_PROXY=true

# Server-Side Sepolia RPC Endpoint (Can use authenticated Infura/Alchemy endpoint with private key)
SERVER_RPC_URL=https://sepolia.infura.io/v3/REPLACE_WITH_PRIVATE_RPC_KEY

# Strict Secure Cookie Enforcement over HTTPS
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# 2. Public Client Configuration (Embedded at build time; prefixed with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Public Canonical Staging Domain (Enforces HTTPS, sets SIWE domain and CSRF check)
NEXT_PUBLIC_APP_URL=https://sepolia-certproof.example.com

# Target Consensus Chain: 11155111 (Sepolia Testnet)
NEXT_PUBLIC_CHAIN_ID=11155111

# Deployed CertProofRegistry Contract Address on Sepolia Testnet
NEXT_PUBLIC_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Browser-Reachable Public Sepolia RPC Endpoint
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org
