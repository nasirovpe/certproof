# ==============================================================================
# CertProof Environment Configuration Reference
# ==============================================================================
# See .env.local.example for local Anvil setup (APP_ENV=local).
# See .env.sepolia.example for Sepolia testnet staging setup (APP_ENV=staging).
# ==============================================================================

# Explicit Deployment Mode:
# - 'local', 'development', or 'test': Permits convenience development defaults on loopback.
# - 'staging' or 'production': STRICTLY rejects default, placeholder, or missing credentials.
APP_ENV=local

# Server-Side Configuration (Read strictly at server runtime; never sent to browser)
# Local convenience defaults shown below. Non-local modes reject these known credentials.
MONGODB_URI=mongodb://certproof_admin:certproof_local_pass@127.0.0.1:27017/certproof?authSource=admin
SESSION_SECRET=dev_session_secret_change_me_to_at_least_32_characters_long
NODE_ENV=development
TRUST_PROXY=false
SERVER_RPC_URL=http://127.0.0.1:8545
COOKIE_SECURE=false

# Public Client Configuration (Embedded at build time; prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_REGISTRY_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org
