# ==============================================================================
# CertProof — Local Development & Container Environment Example
# ==============================================================================
# Copy to .env.local for local Next.js runs, or pass via Docker Compose.
# NEVER commit production secrets or private keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Side Configuration (Read strictly at server runtime; never sent to browser)
# ------------------------------------------------------------------------------
# Explicit Local Deployment Mode: Allows convenience defaults on loopback
APP_ENV=local

# MongoDB Connection String (authenticated)
MONGODB_URI=mongodb://certproof_admin:certproof_local_pass@127.0.0.1:27017/certproof?authSource=admin

# Cryptographic Session Encryption Secret (Minimum 32 characters)
SESSION_SECRET=dev_session_secret_change_me_to_at_least_32_characters_long

# Node Execution Environment
NODE_ENV=development

# Reverse Proxy Header Trust ('true' only when behind trusted perimeter proxy)
TRUST_PROXY=false

# Container-Internal RPC URL (Optional: used by server-side status route if container cannot reach 127.0.0.1)
# Example within Docker Compose network: http://anvil:8545
SERVER_RPC_URL=http://127.0.0.1:8545

# Cookie Security (Default true in production; set to false for local HTTP containers)
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 2. Public Client Configuration (Embedded at build time; prefixed with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Application Canonical Origin (Used for SIWE domain & URI binding and CSRF Origin check)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Target Consensus Chain: 31337 (Anvil Local)
NEXT_PUBLIC_CHAIN_ID=31337

# Deployed CertProofRegistry Contract Address
NEXT_PUBLIC_REGISTRY_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3

# Browser-Reachable Local Anvil RPC Endpoint (Client wallets connect from host browser)
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545
